# Copy to .env and fill in. Never commit .env.

# --- Gemini (constraint C-2: Gemini only, no OpenAI) ---
GOOGLE_API_KEY=

# Model identifiers are configuration, never hardcoded (ADR-002).
# Values below were VERIFIED against the live API on 2026-08-22 and selected on
# measured structured-output latency rather than version number:
#   gemini-3.7-flash 186s | gemini-3.6-flash 34s | gemini-3.5-flash 2.9s
# The entire gemini-2.5-* family returns 404 for new keys, which means every
# model name in Graphiti's published examples is stale.
PCA_LLM_MODEL=gemini-3.5-flash
PCA_LLM_SMALL_MODEL=gemini-3.5-flash-lite
PCA_EMBEDDING_MODEL=gemini-embedding-001
PCA_RERANKER_MODEL=gemini-3.5-flash-lite

# --- Timezone (ADR-011) ---
# IANA zone name. Stored per record so history stays correct if you relocate.
PCA_USER_TIMEZONE=Asia/Kolkata

# --- PostgreSQL (system of record, ADR-005) ---
PCA_POSTGRES_DSN=postgresql://pca:pca@localhost:5432/pca

# --- Neo4j (rebuildable projection, ADR-003; requires 5.26+) ---
PCA_NEO4J_URI=bolt://localhost:7687
PCA_NEO4J_USER=neo4j
PCA_NEO4J_PASSWORD=

# --- Behaviour ---
PCA_LOG_LEVEL=INFO
PCA_RETRIEVAL_BUDGET_SECONDS=25
PCA_EXTRACTION_BARRIER_TIMEOUT_SECONDS=60
PCA_PERSIST_RETRIEVAL_DIAGNOSTICS=false
